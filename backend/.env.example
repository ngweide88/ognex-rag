# ------------------------------------------------------------------ app
APP_NAME=Ognex RAG
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=5000

# ----------------------------------------------------------------- data
DATA_DIR=./data
LOG_DIR=./logs
MAX_UPLOAD_MB=100

# ------------------------------------------------------------ inference
# Any OpenAI-compatible server: SGLang, vLLM, LM Studio, OpenAI...
# Required: point this at your model server and set the model id.
LLM_BASE_URL=http://127.0.0.1:8000
LLM_MODEL=your-chat-model
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=262144
LLM_CONTEXT_WINDOW=32768
LLM_REQUEST_TIMEOUT=600

# Embeddings: local = Chroma's bundled ONNX MiniLM (CPU, ~80 MB once).
# A lexical hasher is used automatically if the model cannot load, and by tests.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1024

# ------------------------------------------------------------- retrieval
TOP_K_CONTEXTS=3
CHUNK_SIZES=500,250,150

# --------------------------------------------------------------- chroma
CHROMA_COLLECTION_PREFIX=kb
CHROMA_BATCH_SIZE=512
